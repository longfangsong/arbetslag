# Telegram Bot Token (required)
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# OpenAI API Key (required)
# Or use an OpenAI-compatible provider
OPENAI_API_KEY=

# Webhook URL (required)
# Public HTTPS URL where Telegram sends updates
# e.g. https://abc.ngrok.io/webhook
WEBHOOK_URL=

# OpenAI-compatible base URL (optional)
# e.g. http://localhost:11434/v1 for Ollama
# OPENAI_BASE_URL=

# Model name (optional, defaults to gpt-4o)
# e.g. llama3.2 for Ollama
# MODEL_NAME=
