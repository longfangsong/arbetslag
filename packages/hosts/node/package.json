{
	"name": "@arbetslag/host-node",
	"version": "0.0.0",
	"private": true,
	"description": "Node host: SQLite store, serial entry, recovery scan, trigger reconciliation, effect executor.",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"type-check": "tsc --noEmit",
		"lint:check": "biome lint src tests",
		"format": "biome format --write src tests",
		"test": "node --test \"tests/**/*.test.ts\""
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"biome": "catalog:",
		"tsdown": "^0.23.0",
		"typescript": "catalog:"
	},
	"dependencies": {
		"@arbetslag/agents": "workspace:*",
		"@arbetslag/kernel": "workspace:*",
		"type-fest": "catalog:",
		"zod": "catalog:"
	}
}
