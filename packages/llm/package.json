{
	"name": "@arbetslag/llm",
	"version": "0.0.0",
	"private": true,
	"description": "Everything about asking a model: history format, conversation/llm/inbox nodes, tools, model.complete and its performers (one subpath per vendor).",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./openai": {
			"types": "./dist/openai.d.mts",
			"import": "./dist/openai.mjs"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"type-check": "tsc --noEmit",
		"lint:check": "biome lint src tests",
		"format": "biome format --write src tests",
		"test": "node --test \"tests/**/*.test.ts\""
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"biome": "catalog:",
		"tsdown": "^0.23.0",
		"typescript": "catalog:"
	},
	"dependencies": {
		"@arbetslag/kernel": "workspace:*",
		"type-fest": "catalog:",
		"zod": "catalog:"
	},
	"peerDependencies": {
		"openai": "^7.33.0"
	},
	"peerDependenciesMeta": {
		"openai": {
			"optional": true
		}
	}
}
