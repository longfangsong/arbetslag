{
	"name": "@arbetslag/monitor",
	"version": "0.0.0",
	"private": true,
	"description": "Read-only monitor for a Node host: workflow list, snapshot detail, live changes over SSE, and creating a workflow from a template.",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown && vite build --config web/vite.config.ts",
		"dev:web": "vite --config web/vite.config.ts",
		"type-check": "tsc --noEmit && tsc --noEmit -p web",
		"lint:check": "biome lint src tests",
		"format": "biome format --write src tests",
		"test": "node --test \"tests/**/*.test.ts\""
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.4",
		"@types/node": "catalog:",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.2.1",
		"biome": "catalog:",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.69.0",
		"radix-ui": "^1.8.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4.3.4",
		"tsdown": "^0.23.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "catalog:",
		"vite": "^8.3.6",
		"zod": "catalog:"
	},
	"dependencies": {
		"@arbetslag/host-node": "workspace:*",
		"@arbetslag/kernel": "workspace:*",
		"type-fest": "catalog:"
	}
}
